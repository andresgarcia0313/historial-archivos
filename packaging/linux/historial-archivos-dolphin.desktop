[Desktop Entry]
Type=Service
MimeType=all/all;
X-KDE-Priority=TopLevel
Actions=versiones;restaurar;
Icon=io.github.andresgarcia0313.HistorialArchivos

[Desktop Action versiones]
Name=Previous versions
Name[es]=Versiones anteriores
Icon=io.github.andresgarcia0313.HistorialArchivos
Exec=historial-archivos --versiones %f

[Desktop Action restaurar]
Name=Restore personal files
Name[es]=Restaurar archivos personales
Icon=io.github.andresgarcia0313.HistorialArchivos
Exec=historial-archivos --restaurar
